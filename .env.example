# HTTP server
PORT=4000
# Logging: trace | debug | info | warn | error | fatal (default: debug in dev, info in production)
# LOG_LEVEL=info

# JWT (auth). In production, use long random strings. For local dev you may omit — insecure defaults apply only when NODE_ENV !== production.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# Comma-separated origins for CORS. In development, defaults to localhost:3000 if unset.
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary (media uploads — replace Firebase Storage)
# CLOUDINARY_CLOUD_NAME = exact "Cloud name" from Dashboard → Settings → API (e.g. dabc123xy). NOT the same as CLOUDINARY_FOLDER.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix for uploads
CLOUDINARY_FOLDER=ideahub
# Max upload size in bytes (default 524288000 ≈ 500MB)
# UPLOAD_MAX_BYTES=524288000

# Create / reset super admin (ubaid@gmail.com / ubaid123) — dev only
# npm run seed:admin -w @ideahub/api

# MongoDB (Section 2+)
MONGODB_URI=mongodb://127.0.0.1:27017/ideas-hub

# Redis / BullMQ (Section 3)
REDIS_URL=redis://localhost:6379

# Firebase Admin — Realtime Database + Storage (Section 3)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# Realtime Database URL (required for scan_updates, presence, typing, push meta)
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Google Cloud APIs (Section 3)
GOOGLE_VISION_API_KEY=
GOOGLE_SPEECH_API_KEY=

# AI Idea Coach (feedback on publish, daily 9:00 brief, chat — uses same LLM keys as validation)
# ENABLE_AI_COACH=true
# COACH_FREE_DAILY_MESSAGES=10
# COACH_DAILY_BRIEF_TZ=UTC
# Optional: unlimited chat for everyone (dev)
# COACH_CHAT_UNLIMITED=false
# Optional: use a different model than validation
# OPENAI_COACH_MODEL=

# Idea validation engine (viability score: community + AI + uniqueness + completeness)
# ENABLE_VALIDATION_ENGINE=true
#
# Option A — OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_VALIDATION_MODEL=gpt-4o-mini
#
# Option B — Google Gemini (free tier / AI Studio key). Base URL auto-picks Gemini when GEMINI_API_KEY is set.
# GEMINI_API_KEY=AIza...
# OPENAI_VALIDATION_MODEL=gemini-2.0-flash
# (or gemini-2.5-flash / model id from https://ai.google.dev/gemini-api/docs/models )
#
# Override chat URL only if needed (OpenAI-compatible /chat/completions):
# VALIDATION_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Gamification (XP, streaks, badges, weekly challenges — Monday 00:00 UTC reset)
# ENABLE_GAMIFICATION=true

# Live idea rooms (Daily.co video + in-app chat, polls, Q&A — mock mode without DAILY_API_KEY)
# ENABLE_LIVE_ROOMS=true
# DAILY_API_KEY=
# Subdomain only, e.g. myteam (becomes https://myteam.daily.co/...)
# DAILY_DOMAIN=myteam.daily.co

# Stripe subscriptions (checkout, webhooks, customer portal)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Dashboard (Products → Prices)
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_INVESTOR_MONTHLY=price_...
# STRIPE_PRICE_INVESTOR_YEARLY=price_...  (optional; falls back to monthly if unset)
# Public web origin for Checkout success/cancel and Billing Portal return
# FRONTEND_URL=http://localhost:3000
# WEB_APP_URL=http://localhost:3000

# Idea marketplace (listings, bids, 15% sale commission — Stripe Connect not wired yet)
# Users created on or before this ISO date may earn the Early Adopter badge (optional)
# EARLY_ADOPTER_END_ISO=2026-04-30T23:59:59.999Z
