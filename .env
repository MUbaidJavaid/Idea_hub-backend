# MongoDB (Section 2+)
MONGODB_URI=mongodb://127.0.0.1:27017/ideas-hub
PORT=4001

# Redis / BullMQ (Section 3)
REDIS_URL=redis://localhost:6379

# Firebase Admin — Realtime Database + Storage (Section 3)
# Web app config does NOT include these: Firebase Console → Project settings → Service accounts → Generate new private key (JSON).
FIREBASE_PROJECT_ID=fir-app-79c12
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=fir-app-79c12.firebasestorage.app
# If your RTDB is in another region, replace with the URL from Firebase Console → Realtime Database.
FIREBASE_DATABASE_URL=https://fir-app-79c12-default-rtdb.firebaseio.com

# Google Cloud APIs (Section 3)
GOOGLE_VISION_API_KEY=AIzaSyDOAwJNTA1lgueFFAS_z0ruvm26Pf13qKU
GOOGLE_SPEECH_API_KEY=AIzaSyBdonC76zzq09xAf49mYQBXu1_JmeUPBWQ


# Cloud name = hostname in Dashboard URL / part after @ in CLOUDINARY_URL (not the folder name).
CLOUDINARY_CLOUD_NAME=dziwtzsrr
CLOUDINARY_API_KEY=887524695724871
CLOUDINARY_API_SECRET=Dwjs2MUwNPxp8-ShqFxkAzwcroI
CLOUDINARY_FOLDER=ideahub
UPLOAD_MAX_BYTES=524288000

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000


JWT_ACCESS_SECRET=dev-ideahub-access-secret
JWT_REFRESH_SECRET=dev-ideahub-refresh-secret

ENABLE_GAMIFICATION=true


# Live idea rooms (Daily.co video + in-app chat, polls, Q&A — mock mode without DAILY_API_KEY)
ENABLE_LIVE_ROOMS=true
DAILY_API_KEY=9efb300a4833145c2dc307ae53c5800ddf3fe576ed66b563178ee4ff6093e5f7
# Subdomain only, e.g. myteam (becomes https://myteam.daily.co/...)
DAILY_DOMAIN=myteam-ideas.daily.co



# Idea validation engine (viability score: community + AI + uniqueness + completeness)
# ENABLE_VALIDATION_ENGINE=true
# OPENAI_API_KEY=
# OPENAI_VALIDATION_MODEL=gpt-4o-mini
GEMINI_API_KEY=AIzaSyBdonC76zzq09xAf49mYQBXu1_JmeUPBWQ
OPENAI_VALIDATION_MODEL=gemini-2.0-flash
# (or gemini-2.5-flash / model id from https://ai.google.dev/gemini-api/docs/models )
#
# Override chat URL only if needed (OpenAI-compatible /chat/completions):
VALIDATION_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai



# I Idea Coach (feedback on publish, daily 9:00 brief, chat — uses same LLM keys as validation)
ENABLE_AI_COACH=true
COACH_FREE_DAILY_MESSAGES=10
COACH_DAILY_BRIEF_TZ=UTC
#  Optional: unlimited chat for everyone (dev)
COACH_CHAT_UNLIMITED=false
# Optional: use a different model than validation
OPENAI_COACH_MODEL=gemini-2.5-flash
 EARLY_ADOPTER_END_ISO=2026-04-30T23:59:59.999Z
