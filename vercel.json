{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/dist/index" }],
  "functions": {
    "dist/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{node_modules/@ffmpeg-installer/**,node_modules/fluent-ffmpeg/**}"
    }
  }
}
